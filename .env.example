# JG Innovative Hub Pvt. Ltd. - Server Environment Configuration
PORT=5000
NODE_ENV=production

# JWT Signing Secret (Generate a strong 64-character random string for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# MongoDB Atlas Connection URI:
# Standard SRV format:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/innovative_hub?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated list of frontends allowed to access this API)
# E.g.: https://your-frontend-domain.com,https://your-admin-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

